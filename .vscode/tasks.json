{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Frontend Dependencies",
			"type": "shell",
			"command": "cd frontend && npm install",
			"group": "build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start Frontend Dev Server",
			"type": "shell",
			"command": "cd frontend && npm run serve",
			"group": "build",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build Frontend",
			"type": "shell",
			"command": "cd frontend && npm run build",
			"group": "build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install Backend Dependencies",
			"type": "shell",
			"command": "cd backend && npm install",
			"group": "build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Initialize Database",
			"type": "shell",
			"command": "cd backend && npm run init-db",
			"group": "build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start Backend Server",
			"type": "shell",
			"command": "cd backend && npm run dev",
			"group": "build",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Full Application",
			"dependsOrder": "parallel",
			"dependsOn": ["Start Backend Server", "Start Frontend Dev Server"],
			"group": "build",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}